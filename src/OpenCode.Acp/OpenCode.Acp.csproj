<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>OpenCode.Acp</AssemblyName>
    <RootNamespace>OpenCode.Acp</RootNamespace>
    <Version>1.0.0</Version>
	<PackageId>OpenCode.Acp</PackageId>
	<PackageVersion>0.1.0</PackageVersion>

	<Title>OpenCode.Acp</Title>

	<Authors>YourName</Authors>

	<Description>
		A lightweight C# ACP client wrapper for communicating with OpenCode through the Agent Client Protocol.
	</Description>

	<PackageTags>opencode;acp;agent;ai;llm;csharp</PackageTags>

	<PackageReadmeFile>README.md</PackageReadmeFile>

	<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

	<!-- MIT를 선택한 경우에만 사용 -->
	<PackageLicenseExpression>MIT</PackageLicenseExpression>

	<RepositoryType>git</RepositoryType>
	<RepositoryUrl>https://github.com/gellston/OpenCode.Acp</RepositoryUrl>

	<PackageOutputPath>$(MSBuildProjectDirectory)\..\..\artifacts</PackageOutputPath>

	<IsPackable>true</IsPackable>

	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
	<None Include="..\..\README.md"
		  Pack="true"
		  PackagePath="\" />
  </ItemGroup>
</Project>
